		<!-- Title + position -->
		<p class="absolute bottom-5 left-0 right-0 text-center text-sm text-white/80">
			{albumLabel}{#if albumLabel && count > 1}<span class="text-white/50"> · </span>{/if}{#if count > 1}<span class="text-white/50">{label} of {count}</span>{/if}
