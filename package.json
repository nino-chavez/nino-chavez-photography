{
  "name": "nino-chavez-gallery-v3",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run check:head && npm run navigation:contract:test && vite build && npm run reader:check:gallery",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsx scripts/taxonomy-check.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "reader:check": "node tools/lib/encounter-audit.mjs --root=. --strict",
    "reader:check:gallery": "node tools/lib/encounter-audit.mjs --root=. --surface=\"gallery interface\" --strict",
    "reader:check:captions": "node tools/lib/encounter-audit.mjs --root=. --surface=\"AI search captions\" --strict",
    "reader:check:alt-text": "node tools/lib/encounter-audit.mjs --root=. --surface=\"AI alt text\" --strict",
    "caption:contract:test": "tsx --test src/lib/ai/caption-contract.test.ts src/lib/ai/alt-text-contract.test.ts src/lib/ai/alt-text-only.test.ts src/lib/ai/ingest-extraction.test.ts",
    "admin:auth:test": "tsx --test src/lib/server/admin-allowlist.test.ts",
    "caption:claims:audit": "tsx scripts/audit-caption-claims.ts",
    "taxonomy:gen": "tsx scripts/taxonomy-gen.ts",
    "taxonomy:check": "tsx scripts/taxonomy-check.ts",
    "taxonomy:audit": "tsx scripts/taxonomy-audit.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "ingest:album": "tsx scripts/ingest-album.ts",
    "backfill:hdr-web": "tsx scripts/backfill-hdr-web.ts",
    "check:sdr-drift": "tsx scripts/check-sdr-drift.ts",
    "backfill:image-embeddings": "tsx scripts/backfill-image-embeddings.ts",
    "backfill:alt-text": "tsx scripts/backfill-alt-text.ts",
    "verify:album": "tsx scripts/verify-album.ts",
    "publish:album": "tsx scripts/publish-album.ts",
    "worker:dev": "cd cloudflare-worker/album-zip && wrangler dev",
    "worker:deploy": "cd cloudflare-worker/album-zip && wrangler deploy",
    "worker:tail": "cd cloudflare-worker/album-zip && wrangler tail",
    "photo:address:test": "tsx --test src/lib/supabase/photo-address.test.ts",
    "faq:copy:test": "tsx --test src/lib/aeo/faq-copy.test.ts",
    "chat:photos:test": "tsx --test src/lib/ai/chat-photo-result.test.ts",
    "share:test": "tsx --test src/lib/analytics/share.test.ts",
    "collections:test": "tsx --test src/lib/collections.test.ts",
    "lightbox:nav:test": "tsx --test src/lib/gallery/lightbox-nav.test.ts",
    "pagination:test": "tsx --test src/lib/api/pagination.test.ts",
    "phototitle:test": "tsx --test src/lib/seo/photo-title.test.ts",
    "filters:test": "tsx --test src/lib/analytics/describe-filters.test.ts",
    "identity:test": "tsx --test src/lib/identity/sightings.test.ts",
    "planner:test": "tsx --test src/lib/search/query-planner.test.ts",
    "naming:test": "tsx --test src/lib/utils/canonical-album-naming.test.ts",
    "embeddings:test": "tsx --test src/lib/ai/embeddings.test.ts src/lib/ai/sharpness.test.ts",
    "replace-plan:test": "tsx --test src/lib/ingest/replace-plan.test.ts",
    "hdr-gainmap:test": "tsx --test src/lib/ai/hdr-gainmap.test.ts",
    "hdr-web-backfill:test": "node --import tsx --test src/lib/ingest/hdr-web-backfill.test.ts",
    "backfill-colors:test": "tsx --test scripts/backfill-sighting-colors.test.ts",
    "latest-album:test": "tsx --test src/lib/albums/latest.test.ts src/lib/albums/publish-target.test.ts",
    "check:head": "node scripts/check-head-tags.mjs",
    "navigation:contract:test": "tsx --test src/lib/navigation-contract.test.ts",
    "analytics:contract:test": "node --import tsx --test src/lib/analytics/collection-contract.test.ts src/lib/analytics/report-contract.test.ts src/lib/analytics/operator-report.test.ts src/lib/analytics/launch-read-model.server.test.ts src/lib/analytics/launch-recap.test.ts src/lib/analytics/album-index.test.ts src/lib/analytics/album-index.server.test.ts src/lib/analytics/home.test.ts src/lib/analytics/home.server.test.ts src/lib/analytics/report-paths.test.ts src/hooks.server.test.ts",
    "analytics:rehearse": "node scripts/rehearse-analytics-local.mjs",
    "analytics:launch:rehearse": "python3 scripts/rehearse-analytics-scheduled.py --migration supabase/migrations/20261005230000_album_settings_publication_provenance.sql --migration supabase/migrations/20261006120000_album_settings_first_publication.sql --migrations-for analytics_read_launch --assertions supabase/rehearsal/launch-baseline.sql --assertions supabase/rehearsal/launch-assertions.sql --output .temp/analytics-local-rehearsal/launch-rehearsal.json",
    "analytics:gallery:rehearse": "python3 scripts/rehearse-analytics-scheduled.py --migration supabase/migrations/20261005230000_album_settings_publication_provenance.sql --migrations-for analytics_read_scheduled_gallery_report --assertions supabase/rehearsal/scheduled-gallery-assertions.sql --output .temp/analytics-local-rehearsal/gallery-rehearsal.json",
    "analytics:dev:local": "node scripts/dev-analytics-local.mjs",
    "analytics:verify:local": "node --import tsx scripts/verify-analytics-local.mjs",
    "analytics:ui:local": "playwright test --config playwright.analytics.config.ts",
    "analytics:site:test": "playwright test --config playwright.site-activity.config.ts --workers=1",
    "analytics:setup:local": "node scripts/rehearse-analytics-local.mjs --setup"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@sveltejs/adapter-auto": "^6.1.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.43.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^19.2.15",
    "@types/sharp": "^0.32.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^4.1.14",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.39",
    "@ai-sdk/svelte": "^3.0.97",
    "@cf-wasm/og": "^0.3.8",
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.75.1",
    "@tanstack/svelte-query": "^6.0.3",
    "ai": "^5.0.97",
    "client-zip": "^2.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "exif-reader": "^2.0.3",
    "isbot": "^5.2.0",
    "lucide-svelte": "^0.546.0",
    "oauth-1.0a": "^2.2.6",
    "posthog-node": "5.54.1",
    "react": "^19.2.6",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  }
}
